# Copy this file to backend/.env and enter only your own credentials.
# backend/.env is ignored by Git and must never be committed.

SUBDFA_GENERATION_PROVIDER=deepseek

# Multiple report-generation profiles. The selected provider is applied
# immediately; the other profiles remain saved for later switching.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-32k
KIMI_BASE_URL=https://api.moonshot.cn/v1
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-1-6-250615
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CUSTOM_GENERATION_API_KEY=
CUSTOM_GENERATION_MODEL=custom-model
CUSTOM_GENERATION_BASE_URL=https://example.com/v1

# Multiple semantic-embedding profiles for DFA state matching.
LOGICRAG_EMBEDDING_PROVIDER=dashscope
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
DOUBAO_EMBEDDING_API_KEY=
DOUBAO_EMBEDDING_MODEL=doubao-embedding-large-text-250515
DOUBAO_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ZHIPU_EMBEDDING_API_KEY=
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CUSTOM_EMBEDDING_API_KEY=
CUSTOM_EMBEDDING_MODEL=embedding-model
CUSTOM_EMBEDDING_BASE_URL=https://example.com/v1

# Compatibility aliases automatically mirror the active embedding profile.
LOGICRAG_EMBEDDING_API_KEY=
LOGICRAG_EMBEDDING_MODEL=text-embedding-v4
LOGICRAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LOGICRAG_EMBEDDING_BATCH_SIZE=10

# Offline AutoLogic induction. The DFA is cached and reused by online queries.
AUTOLOGIC_FREQUENCY_THRESHOLD=0.03
AUTOLOGIC_MAX_CASE_FILES=500

# Optional private corpus location. Raw corpora are never tracked by Git.
FINLDP_ROOT=
# Bundled by default; override only when developing LogicRAG separately.
LOGICRAG_CODE_ROOT=

# iFinD data retrieval through LogicRAG ifind_data_plugin.py.
SUBDFA_IFIND_ENABLED=false
IFIND_USERNAME=
IFIND_PASSWORD=

# Market evidence. AkShare needs no key; Tushare requires a personal token.
SUBDFA_MARKET_DATA_SOURCE=auto
SUBDFA_AKSHARE_ENABLED=true
TUSHARE_TOKEN=
SUBDFA_MARKET_DATA_CACHE_SECONDS=300
SUBDFA_MARKET_DATA_LOOKBACK_DAYS=45

# MySQL storage for query history, SubDFA traces, report outputs, and retrieved materials.
SUBDFA_DATABASE_ENABLED=false
SUBDFA_DATABASE_HOST=127.0.0.1
SUBDFA_DATABASE_PORT=3306
SUBDFA_DATABASE_NAME=logicrag_subdfa
SUBDFA_DATABASE_USER=root
SUBDFA_DATABASE_PASSWORD=

SUBDFA_BACKEND_HOST=127.0.0.1
SUBDFA_BACKEND_PORT=8787
SUBDFA_CORS_ORIGINS=http://127.0.0.1:8790,http://localhost:8790

# Required to edit API credentials from a server deployment. Local-only
# deployments bound to 127.0.0.1 may leave this empty.
SUBDFA_CONFIG_ADMIN_TOKEN=

# Safe offline showcase mode. It uses historical sample semantics embedded in
# the cached DFA and always labels the output as non-live demonstration data.
SUBDFA_DEMO_MODE=true
