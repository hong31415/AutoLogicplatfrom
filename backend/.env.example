# Copy this file to backend/.env and enter only your own credentials.
# backend/.env is ignored by Git and must never be committed.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Semantic embedding API for DFA state matching.
# DashScope example:
LOGICRAG_EMBEDDING_API_KEY=
LOGICRAG_EMBEDDING_MODEL=text-embedding-v4
LOGICRAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LOGICRAG_EMBEDDING_BATCH_SIZE=10

# Offline AutoLogic induction. The DFA is cached and reused by online queries.
AUTOLOGIC_FREQUENCY_THRESHOLD=0.03
AUTOLOGIC_MAX_CASE_FILES=500

# Optional private corpus location. Raw corpora are never tracked by Git.
FINLDP_ROOT=
# Bundled by default; override only when developing LogicRAG separately.
LOGICRAG_CODE_ROOT=

# iFinD data retrieval through LogicRAG ifind_data_plugin.py.
SUBDFA_IFIND_ENABLED=false
IFIND_USERNAME=
IFIND_PASSWORD=

# Market evidence. AkShare needs no key; Tushare requires a personal token.
SUBDFA_MARKET_DATA_SOURCE=auto
TUSHARE_TOKEN=
SUBDFA_MARKET_DATA_CACHE_SECONDS=300
SUBDFA_MARKET_DATA_LOOKBACK_DAYS=45

# MySQL storage for query history, SubDFA traces, report outputs, and retrieved materials.
SUBDFA_DATABASE_ENABLED=false
SUBDFA_DATABASE_HOST=127.0.0.1
SUBDFA_DATABASE_PORT=3306
SUBDFA_DATABASE_NAME=logicrag_subdfa
SUBDFA_DATABASE_USER=root
SUBDFA_DATABASE_PASSWORD=

SUBDFA_BACKEND_HOST=127.0.0.1
SUBDFA_BACKEND_PORT=8787
SUBDFA_CORS_ORIGINS=http://127.0.0.1:8790,http://localhost:8790

# Safe offline showcase mode. It uses historical sample semantics embedded in
# the cached DFA and always labels the output as non-live demonstration data.
SUBDFA_DEMO_MODE=true
